rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }

    // Game Rooms collection
    match /gameRooms/{roomId} {
      allow read, write: if isValidId(roomId);

      match /students/{studentId} {
        allow read, write: if isValidId(studentId);
      }
    }

    // Quiz Reports and History
    match /quizReports/{reportId} {
      allow read, write: if isValidId(reportId);
    }
  }
}
